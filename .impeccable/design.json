  "narrative": {
    "northStar": "A working society desk with an expressive front door.",
    "overview": "SocietyHub pairs a focused sign-in entrance with a calm operating workspace. Independent H hub branding, graphite and pearl surfaces, violet emphasis and stronger Manrope hierarchy define the interface. SEC roles and service context remain functional product content.",
    "keyCharacteristics": [
      "Graphite dark default, pearl light mode and violet emphasis.",
      "Sacramento appears only in the landing A shared home. accent.",
      "Persistent desktop sidebar, compact summaries and real interactive data."
    ],
    "rules": [
      {
        "name": "The Accent Rule",
        "body": "Use Sacramento only in the landing A shared home. accent.",
        "section": "typography"
      },
      {
        "name": "The Status Rule",
        "body": "Color reinforces a written status or numeric value.",
        "section": "colors"
      },
      {
        "name": "The Theme Rule",
        "body": "Use semantic tokens across both themes.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use semantic theme tokens for every surface, label, boundary and data category.",
      "Do keep Sacramento confined to the landing A shared home. accent.",
      "Do preserve visible account context, written statuses, numeric data values, focus outlines and reduced-motion behavior.",
      "Do keep sign-in immediately available and summaries compact."
    ],
    "donts": [
      "Don't restore oversized workspace posters or embedded capsule navigation.",
      "Don't use script or mono fonts for operational labels and headings.",
      "Don't copy sample memberships, rewards, dummy counts or unrelated features into product behavior.",
      "Don't theme QR artwork; preserve black modules on white.",
      "Don't restore ribbons, grain textures, decorative gradient loops, maroon accents or SEC visual branding."
    ]
  }
