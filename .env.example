# Runtime role: use nexus_dev_app locally and in Vercel previews.
# Production must use nexus_prod_app and DATABASE_SCHEMA=nexus_prod.
DATABASE_URL=postgresql://nexus_dev_app:REPLACE_ME@YOUR-ENDPOINT-pooler.neon.tech/neondb?sslmode=verify-full
DATABASE_SCHEMA=nexus_dev
# Setup only: keep owner credentials out of Vercel runtime variables.
# DATABASE_ADMIN_URL=postgresql://OWNER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=verify-full

# In Vercel, use NEXUS_DATABASE_URL for the restricted runtime URL to override
# the Neon integration-managed DATABASE_URL without changing integration secrets.

# Application receipt email: Production only. Leave delivery off locally.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=ses
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=us-east-1
EMAIL_FROM="Student Engineers' Council <no-reply@sec.tamu.edu>"
SOCIETYHUB_APP_URL=https://YOUR-PRODUCTION-DOMAIN
