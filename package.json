    "lucide-react": "^1.66.0",
    "next": "^16.4.4",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
